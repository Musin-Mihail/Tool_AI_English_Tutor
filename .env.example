# Cursor SDK
# Key: Dashboard → API & SSH Keys → Add  https://cursor.com/dashboard
CURSOR_API_KEY=your_cursor_api_key_here
CURSOR_MODEL=composer-2.5

# Optional: Hugging Face Hub token (removes unauthenticated warning, higher rate limits)
# Get token: https://huggingface.co/settings/tokens (Read access is enough)
# HF_TOKEN=hf_...

# Local speech recognition (GPU via CUDA when available)
WHISPER_MODEL=large-v3
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
# Download/cache dir (default: app/data/whisper_models)
# ASR_DOWNLOAD_ROOT=
# Preload Whisper at server start (recommended)
ASR_PRELOAD=true
# Literal decode: greedy, no context smoothing
ASR_BEAM_SIZE=1
ASR_CONDITION_ON_PREVIOUS_TEXT=false
ASR_LOW_CONFIDENCE=0.45

# Acoustic second pass (wav2vec2 CTC)
ACOUSTIC_ASR=true
ACOUSTIC_ASR_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-english
ACOUSTIC_ASR_DEVICE=auto

# Local TTS of the correct English variant (Kokoro)
TTS_ENABLED=true
TTS_VOICE=af_heart
TTS_PRELOAD=true
TTS_SPEED=1.0
